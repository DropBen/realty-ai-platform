# Copy to .env at the repository root. Never use demo mode with customer data.
APP_ENV=development
DEMO_MODE=true
DATABASE_URL=sqlite:///./data/realty-demo.db
APP_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:8000
COOKIE_SECURE=false
SESSION_HOURS=12
# Required outside demo: generate using Fernet.generate_key().decode().
ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback
AI_PROVIDER=disabled
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_TIMEOUT_SECONDS=30
AI_MONTHLY_LIMIT=1000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STORAGE_BACKEND=local
STORAGE_PATH=./data/documents
STORAGE_CONNECTION_STRING=
STORAGE_CONTAINER=documents
LOG_LEVEL=INFO
